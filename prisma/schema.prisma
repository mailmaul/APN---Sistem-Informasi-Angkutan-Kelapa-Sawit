// APN — model data.
//
// Lihat docs/SPEC.md untuk aturan bisnis yang dipetakan ke skema ini.
//
// Catatan konvensi:
// - SQLite tidak mendukung enum Prisma, jadi semua "enum" disimpan sebagai
//   String dan nilainya dikunci lewat konstanta di src/lib/constants.ts.
// - Berat selalu Int dalam KILOGRAM (bukan float) supaya tidak ada galat
//   pembulatan pada angka yang dipakai menghitung uang.
// - Uang selalu Int dalam RUPIAH penuh (tanpa sen).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Owner, admin kantor, dan supir. Login menerima username ATAU nomor HP.
/// Username dipakai staf kantor; supir cukup nomor HP, jadi kolomnya opsional.
/// Disimpan huruf kecil supaya "Lilis" dan "lilis" tidak jadi dua akun.
model User {
  id           String   @id @default(cuid())
  nama         String
  username     String?  @unique
  hp           String   @unique
  passwordHash String
  peran        String // OWNER | ADMIN | SUPIR
  aktif        Boolean  @default(true)

  /// Akun supir yang mendaftar sendiri lewat aplikasi menunggu verifikasi
  /// kantor. Akun yang dibuat admin langsung terverifikasi.
  statusVerifikasi      String    @default("TERVERIFIKASI") // MENUNGGU_VERIFIKASI | TERVERIFIKASI | DITOLAK
  alasanTolakVerifikasi String?
  diverifikasiOlehId    String?
  diverifikasiPada      DateTime?
  noSim                 String?
  fotoSimUrl            String?
  /// Nopol terakhir yang dipakai supir; mengisi otomatis form Buat DO.
  nopolTerakhir         String?
  /// Dipakai jalur persetujuan Telegram dan push FCM; keduanya menyusul.
  telegramId            String?
  fcmToken              String?
  createdAt    DateTime @default(now())

  ritSebagaiSupir Rit[]              @relation("SupirRit")
  kontrakDibuat   Kontrak[]          @relation("KontrakPembuat")
  penimbangan     Penimbangan[]
  fotoDiupload    Foto[]
  riwayatStatus   RiwayatStatus[]
  settlement      Settlement[]
  pushSubs        PushSubscription[]
  pengajuan       PengajuanDo[]      @relation("PengajuanSupir")
  pengajuanDiputus PengajuanDo[]     @relation("PengajuanPemutus")

  @@index([peran, aktif])
}

model Truk {
  id        String   @id @default(cuid())
  nopol     String   @unique
  taraBaku  Int // kg, pembanding untuk mendeteksi salah ketik tara
  kapasitas Int // kg
  aktif     Boolean  @default(true)
  catatan   String?
  createdAt DateTime @default(now())

  rit Rit[]
}

model Shipper {
  id        String   @id @default(cuid())
  nama      String
  kontak    String?
  alamat    String?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())

  kontrak Kontrak[]
}

model Lokasi {
  id        String   @id @default(cuid())
  nama      String
  alamat    String?
  lat       Float?
  lng       Float?
  jenis     String // ASAL | TUJUAN | KEDUANYA
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())

  kontrakAsal   Kontrak[] @relation("KontrakAsal")
  kontrakTujuan Kontrak[] @relation("KontrakTujuan")
}

/// SPK / kontrak kerja dari shipper. Satu kontrak diturunkan jadi banyak Rit.
model Kontrak {
  id             String    @id @default(cuid())
  noSpk          String    @unique
  shipperId      String
  jenisBarang    String // PALM_KERNEL | PALM_SHELL | BESI
  lokasiAsalId   String
  lokasiTujuanId String
  totalTonase    Float // ton
  periodeMulai   DateTime
  periodeSelesai DateTime?
  status         String    @default("AKTIF") // AKTIF | SELESAI | DIBATALKAN

  // Tarif berlaku saat ini. Nilai ini DISALIN ke Rit waktu DO terbit supaya
  // perubahan tarif tidak mengubah rit yang sudah berjalan/selesai.
  // Rupiah per KG (bukan per ton): surat SA dari shipper menuliskan ongkos
  // angkut per kg, dan invoice yang berjalan memakai satuan itu.
  tarifShipperPerKg Int
  ongkosSupirPerRit  Int // rupiah borongan per rit, biaya APN

  /// Menimpa tarif selisih default per jenis barang. Kosong = pakai default
  /// di src/lib/constants.ts (Kernel 7.500/kg, Shell 1.000/kg).
  tarifSelisihPerKg Int?

  /// Kuota unit angkutan yang boleh berjalan bersamaan atas kontrak ini.
  /// 0 berarti belum diisi dan diperlakukan sebagai tanpa batas, supaya
  /// kontrak lama tidak mendadak menolak pengajuan.
  unitDiminta Int @default(0)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipper      Shipper @relation(fields: [shipperId], references: [id])
  lokasiAsal   Lokasi  @relation("KontrakAsal", fields: [lokasiAsalId], references: [id])
  lokasiTujuan Lokasi  @relation("KontrakTujuan", fields: [lokasiTujuanId], references: [id])
  createdBy    User    @relation("KontrakPembuat", fields: [createdById], references: [id])

  rit       Rit[]
  pengajuan PengajuanDo[]

  @@index([status])
  @@index([shipperId])
}

/// Satu DO = satu rit = satu truk. Inti transaksi sistem.
model Rit {
  id            String   @id @default(cuid())
  noDo          String   @unique
  kontrakId     String
  trukId        String?
  supirId       String?
  tanggalTerbit DateTime @default(now())
  status        String   @default("DITERBITKAN")

  // Snapshot tarif saat DO terbit — jangan pernah dibaca ulang dari Kontrak.
  tarifShipperPerKgSnapshot  Int
  ongkosSupirPerRitSnapshot  Int

  // Checkpoint waktu. Selisih tiba→selesai = lama antri + proses.
  tibaMuat       DateTime?
  selesaiMuat    DateTime?
  tibaBongkar    DateTime?
  selesaiBongkar DateTime?

  // Hasil perhitungan, dibekukan saat rit diselesaikan admin.
  selisihKg     Int? // positif = barang berkurang, negatif = bertambah
  kelebihanKg   Int? // setelah dikurangi toleransi 20 kg
  nilaiSelisih  Int? // rupiah nilai susut di luar toleransi
  tagihanShipper Int?

  /// Potongan yang dibebankan ke supir atas susut (DO: "ditanggung driver
  /// atau pemilik kendaraan"). Hanya selisih POSITIF yang dipotong.
  potonganSupir     Int?
  /// Bagian potongan yang dimaafkan owner. Satu-satunya jalan keluar dari
  /// potongan — selalu menyimpan alasan dan siapa yang memberi.
  pemaafanPotongan  Int       @default(0)
  alasanPemaafan    String?
  dimaafkanOlehId   String?
  dimaafkanPada     DateTime?
  /// Ongkos borongan setelah potongan efektif. Boleh negatif = saldo utang.
  ongkosSupir    Int?

  slipFisikDiterima Boolean   @default(false)
  slipFisikTanggal  DateTime?

  /// Pengajuan supir yang melahirkan rit ini; kosong untuk DO terbitan kantor.
  pengajuanId String? @unique
  /// Berkas DO yang bisa dibuka supir dari aplikasi.
  doPdfUrl    String?

  alasanBatal String?
  catatan     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kontrak       Kontrak         @relation(fields: [kontrakId], references: [id])
  pengajuan     PengajuanDo?    @relation(fields: [pengajuanId], references: [id])
  truk          Truk?           @relation(fields: [trukId], references: [id])
  supir         User?           @relation("SupirRit", fields: [supirId], references: [id])
  penimbangan   Penimbangan[]
  foto          Foto[]
  titikGps      TitikGps[]
  riwayatStatus RiwayatStatus[]
  biaya         Biaya[]
  kendala       Kendala[]
  klaim         Klaim?

  @@index([status])
  @@index([supirId, status])
  @@index([kontrakId])
  @@index([tanggalTerbit])
}

/// Slip timbang.
///
/// Sisi MUAT memakai bukti timbangan PKS yang memuat bruto/tara/netto.
/// Sisi BONGKAR sering hanya berupa tanda terima bertulis tangan yang
/// mencantumkan netto saja — karena itu bruto & tara opsional, sedangkan
/// netto selalu ada. Kalau bruto & tara diisi, netto wajib sama dengan
/// selisihnya (divalidasi di route, bukan di basis data).
model Penimbangan {
  id            String   @id @default(cuid())
  ritId         String
  jenis         String // MUAT | BONGKAR
  tanggal       DateTime
  noTiket       String?
  bruto         Int? // kg, kosong kalau slip tujuan hanya memuat netto
  tara          Int? // kg, idem
  netto         Int // kg
  namaTimbangan String?
  sumberAngka   String   @default("SLIP") // SLIP | KONFIRMASI_MANUAL
  catatan       String?
  dibuatOlehId  String
  createdAt     DateTime @default(now())

  rit       Rit  @relation(fields: [ritId], references: [id], onDelete: Cascade)
  dibuatOleh User @relation(fields: [dibuatOlehId], references: [id])

  @@unique([ritId, jenis])
}

model Foto {
  id             String   @id @default(cuid())
  ritId          String
  jenis          String // SLIP_MUAT | SLIP_BONGKAR | KENDALA | LAIN
  url            String
  lat            Float?
  lng            Float?
  waktu          DateTime @default(now())
  diuploadOlehId String

  rit          Rit  @relation(fields: [ritId], references: [id], onDelete: Cascade)
  diuploadOleh User @relation(fields: [diuploadOlehId], references: [id])

  @@index([ritId, jenis])
}

model TitikGps {
  id      String   @id @default(cuid())
  ritId   String
  lat     Float
  lng     Float
  waktu   DateTime @default(now())
  leg     String // MENUJU_MUAT | MENUJU_BONGKAR
  akurasi Float?

  rit Rit @relation(fields: [ritId], references: [id], onDelete: Cascade)

  @@index([ritId, waktu])
}

/// Jejak audit setiap perpindahan status, lengkap dengan lokasi saat ditekan.
model RiwayatStatus {
  id      String   @id @default(cuid())
  ritId   String
  dari    String?
  ke      String
  olehId  String
  waktu   DateTime @default(now())
  lat     Float?
  lng     Float?
  catatan String?

  rit  Rit  @relation(fields: [ritId], references: [id], onDelete: Cascade)
  oleh User @relation(fields: [olehId], references: [id])

  @@index([ritId, waktu])
}

model Biaya {
  id      String   @id @default(cuid())
  ritId   String
  jenis   String // BBM | UANG_MAKAN | LAIN
  nominal Int // rupiah
  tanggal DateTime @default(now())
  catatan String?

  rit Rit @relation(fields: [ritId], references: [id], onDelete: Cascade)

  @@index([ritId])
}

model Kendala {
  id            String    @id @default(cuid())
  ritId         String
  jenis         String // MOGOK | KECELAKAAN | ANTRIAN | SLIP_BERMASALAH | LAIN
  waktu         DateTime  @default(now())
  lat           Float?
  lng           Float?
  catatan       String
  fotoUrl       String?
  penyelesaian  String?
  selesaiPada   DateTime?

  rit Rit @relation(fields: [ritId], references: [id], onDelete: Cascade)

  @@index([ritId])
}

/// Tuntutan ganti rugi dari shipper atas barang yang kurang.
model Klaim {
  id      String   @id @default(cuid())
  ritId   String   @unique
  nominal Int // rupiah
  tanggal DateTime @default(now())
  status  String   @default("DIAJUKAN") // DIAJUKAN | DISETUJUI | DITOLAK | LUNAS
  catatan String?

  rit Rit @relation(fields: [ritId], references: [id], onDelete: Cascade)
}

/// Rekap bulanan bayaran supir. Ongkos borongan x jumlah rit SELESAI.
model Settlement {
  id          String    @id @default(cuid())
  supirId     String
  bulan       String // format YYYY-MM
  jumlahRit   Int
  totalOngkos   Int // rupiah, borongan kotor sebelum potongan
  totalPotongan Int @default(0) // rupiah, akumulasi potongan susut
  status      String    @default("DRAFT") // DRAFT | FINAL | DIBAYAR
  dibayarPada DateTime?
  catatan     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supir User @relation(fields: [supirId], references: [id])

  @@unique([supirId, bulan])
  @@index([bulan])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Pengajuan DO oleh supir lewat aplikasi Android.
///
/// Membalik arah sistem web: di web admin menerbitkan DO lalu menugaskan
/// supir, di sini supir mengajukan dan kantor memutuskan. Rit baru lahir saat
/// pengajuan disetujui, dan kuota PO dikunci pada transaksi persetujuan itu
/// supaya dua approver tidak bisa melewati batas unit.
model PengajuanDo {
  id        String @id @default(cuid())
  kontrakId String
  supirId   String

  /// Disalin dari isian supir, bukan dibaca ulang dari profil: DO harus
  /// memuat data orang yang benar-benar membawa muatan hari itu.
  nama          String
  nopol         String
  noSim         String
  noHp          String
  fotoSelfieUrl String

  status            String  @default("DIAJUKAN") // DIAJUKAN | DISETUJUI | DITOLAK | KEDALUWARSA
  alasanTolak       String?
  diputusOlehId     String?
  sumberPersetujuan String? // WEB | TELEGRAM
  pesanTelegramId   String?
  diputusPada       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kontrak    Kontrak @relation(fields: [kontrakId], references: [id])
  supir      User    @relation("PengajuanSupir", fields: [supirId], references: [id])
  diputusOleh User?  @relation("PengajuanPemutus", fields: [diputusOlehId], references: [id])
  rit        Rit?

  @@index([status])
  @@index([supirId, status])
  @@index([kontrakId, status])
}
