<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ApnSupir" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/apn_latar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ApnSupir.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/apn_teal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ApnSupir</item>
    </style>
</resources>
